{
  "name": "credit-dragon-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Credit Dragon bill negotiator + gamification prototype (HTML + Tailwind, no framework).",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./styles.css --minify",
    "build:data": "node ./tools/build-data.js",
    "build:icons": "node ./tools/build-icons.js",
    "vendor:gel": "node ./tools/vendor-gel.mjs",
    "build": "npm run build:data && npm run build:icons && npm run build:css",
    "watch:css": "tailwindcss -i ./src/input.css -o ./styles.css --watch",
    "audit": "node ./scripts/audit.mjs",
    "shots": "node ./scripts/screenshot.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.1.12"
  }
}
