+@layer components{
+  /* ---------- Onboarding ----------
+     Full-phone first run: welcome, scan, Carlos's questions, done. Sits above
+     the header and tab bar, below the AR view. GEL geometry throughout: 6px
+     rhythm, 42px buttons, squarish radii, hero navy for headings. */
+  .ob {
+    position: absolute; inset: 0; z-index: 55;
+    display: flex; flex-direction: column;
+    background: var(--background-white);
+    animation: ob-in 0.32s var(--ease);
+  }
+  .ob.leaving { opacity: 0; transform: translateY(8px); transition: opacity 0.24s var(--ease), transform 0.24s var(--ease); }
+  @keyframes ob-in { from { opacity: 0; } to { opacity: 1; } }
+
+  .ob-top {
+    flex: none; height: 54px; padding: 0 12px;
+    display: grid; grid-template-columns: 36px 1fr 36px; align-items: center; justify-items: center;
+    border-bottom: 1px solid var(--border-muted-soft);
+  }
+  .ob-top .gel-logo { height: 22px; }
+  .ob-back {
+    width: 36px; height: 36px; border: 0; background: none; border-radius: 4px; cursor: pointer;
+    display: inline-flex; align-items: center; justify-content: center; color: var(--text-hero);
+  }
+  .ob-back svg { width: 22px; height: 22px; transform: rotate(180deg); }
+  .ob-back:active { background: var(--surface-muted-faint); }
+
+  .ob-body { flex: 1; overflow-y: auto; scrollbar-width: none; }
+  .ob-body::-webkit-scrollbar { display: none; }
+  .ob-pane {
+    min-height: 100%; padding: 18px 24px 24px;
+    display: flex; flex-direction: column;
+    animation: screen-in 0.28s var(--ease);
+  }
+
+  .ob-hero {
+    display: flex; justify-content: center; align-items: center;
+    height: 168px; margin: 0 -24px 18px;
+    background: radial-gradient(120% 90% at 50% 100%, var(--surface-hero-faint) 0%, #fff 70%);
+  }
+  .ob-egg { width: 120px; height: 120px; display: flex; align-items: center; justify-content: center; }
+  .ob-egg-img { max-width: 120px; max-height: 120px; font-size: 92px; line-height: 1; text-align: center; }
+  .ob-egg--wobble { animation: ob-wobble 1.1s var(--ease) infinite; transform-origin: 50% 90%; }
+  @keyframes ob-wobble {
+    0%, 100% { transform: rotate(0); }
+    20% { transform: rotate(-7deg); }
+    40% { transform: rotate(6deg); }
+    60% { transform: rotate(-3deg); }
+  }
+
+  .ob-title {
+    font-family: var(--font-brand), var(--font-family-sans);
+    font-size: var(--typography-body-size-7); line-height: var(--typography-body-line-height-7);
+    color: var(--text-heading); font-weight: 700; margin: 0 0 12px;
+  }
+  .ob-lead { font-size: var(--typography-body-size-9); line-height: 1.45; color: var(--text-body); margin: 0 0 18px; }
+
+  .ob-promises { list-style: none; margin: 0 0 18px; padding: 0; display: grid; gap: 12px; }
+  .ob-promises li {
+    display: grid; grid-template-columns: 24px 1fr; gap: 12px; align-items: start;
+    font-size: var(--typography-body-size-10); line-height: 1.4; color: var(--text-body);
+  }
+  .ob-promises li svg { width: 24px; height: 24px; color: var(--text-hero); }
+  .ob-promises b { color: var(--text-heading); }
+
+  .ob-actions { margin-top: auto; display: grid; gap: 6px; padding-top: 12px; }
+  .ob-actions .gel-btn-text { justify-self: center; }
+
+  /* scan */
+  .ob-checks { list-style: none; margin: 0 0 18px; padding: 0; display: grid; gap: 12px; }
+  .ob-checks li {
+    display: grid; grid-template-columns: 24px 1fr; gap: 12px; align-items: center;
+    font-size: var(--typography-body-size-9); color: var(--text-body);
+    opacity: 0; transform: translateY(4px); animation: ob-tick 0.35s var(--ease) forwards;
+  }
+  .ob-checks li svg {
+    width: 24px; height: 24px; padding: 3px; border-radius: 50%;
+    background: var(--surface-success-faint); color: var(--text-success);
+  }
+  @keyframes ob-tick { to { opacity: 1; transform: none; } }
+  .ob-scanbar { margin: 6px 0 12px; }
+  .ob-scanfill { width: 0; animation: ob-fill 3.1s var(--ease) forwards; }
+  @keyframes ob-fill { to { width: 100%; } }
+  .ob-source { margin-top: auto; text-align: center; }
+
+  /* questions */
+  .ob-dots { display: flex; gap: 6px; margin: 0 0 6px; }
+  .ob-dots i { flex: 1; height: 4px; border-radius: 2px; background: var(--surface-muted-soft); }
+  .ob-dots i.done { background: var(--surface-hero); }
+  .ob-dots i.on { background: var(--surface-primary); }
+  .ob-count { font-size: var(--typography-body-size-10); color: var(--text-muted); margin: 0 0 12px; }
+  .ob-impact { align-self: flex-start; margin-bottom: 12px; }
+  .ob-question {
+    font-family: var(--font-brand), var(--font-family-sans);
+    font-size: var(--typography-body-size-8); line-height: 1.3;
+    color: var(--text-heading); font-weight: 700; margin: 0 0 12px;
+  }
+  .ob-why { margin-bottom: 18px; }
+  .ob-why-text { font-size: var(--typography-body-size-10); line-height: 1.4; color: var(--text-body); margin: 0; }
+  .ob-txs { list-style: none; margin: 12px 0 0; padding: 0; border-top: 1px solid var(--border-muted-soft); }
+  .ob-tx {
